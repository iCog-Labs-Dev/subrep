{
  "schema_version": "subrep.recipe_book.v2",
  "environment": "mo-lunar-lander-v3",
  "goals": {
    "land_on_pad": {
      "achieved_when": {"landed": true, "over_pad": true},
      "terminal": true
    },
    "recover_stability": {
      "achieved_when": {"upright": true}
    }
  },
  "methods": [
    {
      "name": "careful_landing",
      "subgoals": [
        {"upright": true},
        {"over_pad": true},
        {"near_ground": true, "slow": true},
        {"landed": true, "over_pad": true}
      ]
    },
    {
      "name": "fuel_saving_landing",
      "requires": {"near_ground": false},
      "subgoals": [
        {"upright": true},
        {"over_pad": true},
        {"descent_underway": true},
        {"slow": true},
        {"landed": true, "over_pad": true}
      ]
    },
    {
      "name": "direct_descent",
      "subgoals": [
        {"near_ground": true, "slow": true},
        {"landed": true, "over_pad": true}
      ]
    }
  ],
  "skills": {
    "stabilise": {
      "requires": {},
      "effects": {"upright": true},
      "may_change": ["over_pad", "near_ground", "slow", "falling_fast", "landed", "descent_underway"]
    },
    "move_over_pad": {
      "requires": {"upright": true},
      "effects": {"over_pad": true},
      "may_change": ["upright", "slow", "falling_fast", "descent_underway"]
    },
    "slow_descent": {
      "requires": {},
      "effects": {"near_ground": true, "slow": true, "falling_fast": false, "descent_underway": true},
      "may_change": ["upright", "over_pad"]
    },
    "free_fall": {
      "requires": {"over_pad": true},
      "effects": {"descent_underway": true},
      "may_change": ["upright", "over_pad", "near_ground", "slow", "falling_fast"]
    },
    "brake": {
      "requires": {},
      "effects": {"slow": true, "falling_fast": false},
      "may_change": ["upright", "over_pad", "descent_underway"]
    },
    "touch_down": {
      "requires": {"slow": true},
      "effects": {"landed": true},
      "may_change": ["upright", "over_pad", "near_ground", "slow", "descent_underway"]
    }
  }
}
